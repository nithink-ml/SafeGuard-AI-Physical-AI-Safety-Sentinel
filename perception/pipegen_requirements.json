{
  "pipegen_version": "0.5.1",
  "project_name": "SafeGuard AI — Physical AI Safety Sentinel",
  "stage": "1_requirement",
  "target_platforms": [
    {
      "platform_id": "nvidia-jetson-orin",
      "architecture": "aarch64",
      "accelerator": "Ampere GPU (1024 CUDA Cores, 32 Tensor Cores)",
      "target_os": "Linux Ubuntu 22.04 LTS (JetPack 6.0)"
    },
    {
      "platform_id": "nvidia-dgpu-x86",
      "architecture": "x86_64",
      "accelerator": "NVIDIA GeForce RTX (Compute 7.0+)",
      "target_os": "Linux Ubuntu 22.04 LTS"
    }
  ],
  "requirements": {
    "input_streams": [
      {
        "stream_id": "cam_factory_overhead_01",
        "type": "V4L2_UVC",
        "uri": "/dev/video0",
        "resolution": {
          "width": 1280,
          "height": 720
        },
        "target_framerate": 30
      }
    ],
    "perception_tasks": [
      {
        "task_type": "object_detection",
        "target_class": "person",
        "class_id": 0,
        "model_architecture": "yolov8n",
        "input_dimensions": [1, 3, 640, 640],
        "precision": "FP16",
        "target_inference_latency_ms": 15.0
      }
    ],
    "analytics_rules": {
      "spatial_rule": "foot_point_polygon_containment",
      "geometry_anchor": "bottom_center",
      "persistence_threshold_frames": 3,
      "clearance_dwell_frames": 5,
      "minimum_confidence": 0.55
    },
    "egress": {
      "protocol": "MQTT",
      "topic": "safeguard/events",
      "format": "JSON",
      "schema_version": "1.0",
      "qos": 1
    }
  }
}
