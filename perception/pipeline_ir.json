{
  "pipegen_version": "0.5.1",
  "stage": "2_pipeline_ir",
  "pipeline_name": "safeguard_perception_ir",
  "graph": {
    "nodes": [
      {
        "id": "node_src_0",
        "element": "v4l2src",
        "type": "source",
        "properties": {
          "device": "/dev/video0"
        },
        "output_caps": "video/x-raw, width=1280, height=720, framerate=30/1"
      },
      {
        "id": "node_conv_0",
        "element": "nvvideoconvert",
        "type": "converter",
        "properties": {
          "compute-hw": "GPU"
        },
        "output_caps": "video/x-raw(memory:NVMM), format=NV12"
      },
      {
        "id": "node_mux_0",
        "element": "nvstreammux",
        "type": "muxer",
        "properties": {
          "batch-size": 1,
          "width": 1280,
          "height": 720,
          "batched-push-timeout": 40000,
          "live-source": 1
        }
      },
      {
        "id": "node_infer_0",
        "element": "nvinfer",
        "type": "inference_engine",
        "properties": {
          "config-file-path": "perception/model_config.json",
          "model-engine-file": "perception/engines/yolov8n_fp16.engine",
          "batch-size": 1,
          "interval": 0,
          "output-tensor-meta": 0
        }
      },
      {
        "id": "node_analytics_0",
        "element": "nvdsanalytics",
        "type": "metadata_analytics",
        "properties": {
          "config-file": "configs/zones.json",
          "enable-roi": 1
        }
      },
      {
        "id": "node_probe_footpoint",
        "element": "craftifai_probe",
        "type": "custom_analytics_probe",
        "properties": {
          "handler": "perception.zone_filter.TemporalPersistenceTracker",
          "persistence_frames": 3,
          "foot_point_rule": "bottom_center",
          "egress_topic": "safeguard/events"
        }
      },
      {
        "id": "node_tiler_0",
        "element": "nvmultistreamtiler",
        "type": "tiler",
        "properties": {
          "rows": 1,
          "columns": 1,
          "width": 1280,
          "height": 720
        }
      },
      {
        "id": "node_osd_0",
        "element": "nvdsosd",
        "type": "osd",
        "properties": {
          "process-mode": "GPU",
          "display-text": 1,
          "display-bbox": 1
        }
      },
      {
        "id": "node_sink_0",
        "element": "nveglglessink",
        "type": "sink",
        "properties": {
          "sync": 0,
          "qos": 0
        }
      }
    ],
    "edges": [
      { "from": "node_src_0", "to": "node_conv_0" },
      { "from": "node_conv_0", "to": "node_mux_0" },
      { "from": "node_mux_0", "to": "node_infer_0" },
      { "from": "node_infer_0", "to": "node_analytics_0" },
      { "from": "node_analytics_0", "to": "node_probe_footpoint" },
      { "from": "node_probe_footpoint", "to": "node_tiler_0" },
      { "from": "node_tiler_0", "to": "node_osd_0" },
      { "from": "node_osd_0", "to": "node_sink_0" }
    ]
  }
}
